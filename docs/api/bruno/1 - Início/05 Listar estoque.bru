meta {
  name: Listar estoque
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/admin/inventory-items
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  const items = res.getBody().data;
  bru.setVar("partId", items.find((x) => x.sku === "DEMO-PASTILHA").id);
  bru.setVar("supplyId", items.find((x) => x.sku === "DEMO-OLEO").id);
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
