meta {
  name: Finalizar OS
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/admin/service-orders/{{orderId}}/complete
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "expectedVersion": {{version}}
  }
}

script:post-response {
  bru.setVar("version", res.getBody().version);
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
