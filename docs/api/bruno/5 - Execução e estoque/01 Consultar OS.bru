meta {
  name: Consultar OS
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/service-orders/{{orderId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  bru.setVar("version", res.getBody().version);
  bru.setVar("serviceLineId", res.getBody().services[0].id);
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
